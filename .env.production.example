# Flask production settings
SECRET_KEY=replace-with-a-long-random-production-secret
FLASK_DEBUG=false

# Public site settings
BASE_URL=https://theonlydrop.pedrosimao.work
BRAND_NAME=THE ONLY DROP
CONTACT_EMAIL=hello@pedrosimao.work

# Production MariaDB database
DATABASE_URL=mysql+pymysql://directadmin_database_user:directadmin_database_password@localhost/directadmin_database_name

# Logging
LOG_LEVEL=INFO
LOG_TO_FILE=true

# Stripe test-mode keys for portfolio demo
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Printify settings
PRINTIFY_API_TOKEN=replace-with-printify-api-token
PRINTIFY_SHOP_ID=replace-with-printify-shop-id

# Demo safety
PRINTIFY_FULFILLMENT_ENABLED=false